{
  "manifest_version": 3,
  "name": "Kabir Download Manager",
  "description": "Automatically capture browser downloads in KDM, or send links and detected media.",
  "version": "1.2.0",
  "key": "",
  "permissions": ["nativeMessaging", "contextMenus", "webRequest", "storage", "activeTab", "downloads"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js" },
  "icons": { "16": "icons/kdm-16.png", "32": "icons/kdm-32.png", "48": "icons/kdm-48.png", "128": "icons/kdm-128.png" },
  "action": { "default_title": "Download with KDM", "default_popup": "popup.html", "default_icon": { "16": "icons/kdm-16.png", "32": "icons/kdm-32.png" } }
}
